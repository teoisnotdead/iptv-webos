# Copia este archivo como .env.local (no se sube a git) y completa los datos de esta instalación.

# Servidor que aparece por defecto en el login (el usuario puede cambiarlo).
VITE_PANEL_URL=http://servidor.ejemplo.com:8080

# true = versión de revendedor: el servidor queda fijo y no se muestra en el login.
VITE_PANEL_LOCK=false

# Marca.
VITE_BRAND_NAME=IPTV
VITE_BRAND_COLOR=#a78bfa

# Identificador de la app en el TV (minúsculas, estilo dominio invertido; no puede empezar con com.lge, com.webos ni com.palm).
APP_ID=app.iptv.player
APP_VENDOR=IPTV
# Si falta, se usa la versión de package.json.
# APP_VERSION=0.1.0

# Nombre del TV configurado con `ares-setup-device` (para npm run tv:install / tv:launch / tv:inspect).
WEBOS_DEVICE=tv
